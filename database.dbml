Project KI_Rechnungsassistent_Podologie {
  database_type: 'SQLite'

  Note: '''
  ENGLISH
  Authoritative source: app/db/models.py. This document describes the current
  SQLAlchemy schema and its domain meaning. Application-managed defaults are
  explicitly identified; they are not assumed to be SQLite server defaults.

  DEUTSCH
  Technische Quelle: app/db/models.py. Dieses Dokument beschreibt das aktuelle
  SQLAlchemy-Schema und seine fachliche Bedeutung. Von der Anwendung gesetzte
  Standardwerte sind ausdrücklich gekennzeichnet; sie werden nicht als
  SQLite-Server-Defaults vorausgesetzt.
  '''
}

Table patients {
  id integer [pk, increment, note: '''ENGLISH: Internal, unique technical patient identifier. DEUTSCH: Interne, eindeutige technische Kennung des Patienten.''']
  patient_nr varchar(30) [not null, unique, note: '''ENGLISH: Human-readable unique patient number, generated by the application. DEUTSCH: Sichtbare eindeutige Patientennummer, die von der Anwendung erzeugt wird.''']
  first_name varchar(120) [not null, note: '''ENGLISH: Patient first name used for master data and matching. DEUTSCH: Vorname des Patienten für Stammdaten und Zuordnung.''']
  last_name varchar(120) [not null, note: '''ENGLISH: Patient last name; together with first_name it has a search index, not a uniqueness constraint. DEUTSCH: Nachname; zusammen mit first_name besteht ein Suchindex, aber keine Eindeutigkeitsregel.''']
  birth_date date [note: '''ENGLISH: Optional date of birth for identification and master data. DEUTSCH: Optionales Geburtsdatum zur Identifikation und Stammdatenpflege.''']
  deceased boolean [not null, note: '''ENGLISH: Indicates known death; application default is false. DEUTSCH: Kennzeichnet einen bekannten Todesfall; Anwendungsstandard ist false.''']
  death_date date [note: '''ENGLISH: Optional known date of death; it may be null even when deceased is true. DEUTSCH: Optional bekanntes Sterbedatum; es darf auch bei deceased=true leer bleiben.''']
  street varchar(200) [note: '''ENGLISH: Optional residential street and house number. DEUTSCH: Optionale Straße und Hausnummer der Wohnadresse.''']
  zip varchar(20) [note: '''ENGLISH: Optional postal code of the residential address. DEUTSCH: Optionale Postleitzahl der Wohnadresse.''']
  city varchar(120) [note: '''ENGLISH: Optional city of the residential address. DEUTSCH: Optionaler Ort der Wohnadresse.''']
  invoice_name varchar(200) [note: '''ENGLISH: Optional alternative invoice recipient name. DEUTSCH: Optionaler Name eines abweichenden Rechnungsempfängers.''']
  invoice_street varchar(200) [note: '''ENGLISH: Optional street and house number of the alternative invoice address. DEUTSCH: Optionale Straße und Hausnummer der abweichenden Rechnungsadresse.''']
  invoice_zip varchar(20) [note: '''ENGLISH: Optional postal code of the alternative invoice address. DEUTSCH: Optionale Postleitzahl der abweichenden Rechnungsadresse.''']
  invoice_city varchar(120) [note: '''ENGLISH: Optional city of the alternative invoice address. DEUTSCH: Optionaler Ort der abweichenden Rechnungsadresse.''']
  home_name varchar(200) [note: '''ENGLISH: Optional nursing or residential home name, also used as matching context. DEUTSCH: Optionaler Name eines Pflege- oder Seniorenheims, auch als Zuordnungskontext genutzt.''']
  room varchar(50) [note: '''ENGLISH: Optional room number or room designation at the home. DEUTSCH: Optionale Zimmernummer oder Zimmerbezeichnung im Heim.''']
  active boolean [not null, note: '''ENGLISH: Selectability status; application default is true. Inactive records remain for history. DEUTSCH: Status der Auswählbarkeit; Anwendungsstandard ist true. Inaktive Datensätze bleiben historisch erhalten.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']
  updated_at datetime [not null, note: '''ENGLISH: UTC timestamp updated by the application on changes. DEUTSCH: Von der Anwendung bei Änderungen aktualisierter UTC-Zeitpunkt.''']

  Indexes {
    (last_name, first_name) [name: 'idx_patients_name', note: '''ENGLISH: Supports patient-name lookup; names are not unique. DEUTSCH: Unterstützt die Patientensuche nach Namen; Namen sind nicht eindeutig.''']
  }

  Note: '''
  ENGLISH
  Table: patients. Stores patient master data, optional residential and invoice
  addresses, home context and lifecycle information. A patient may be inactive
  for reasons other than death and must remain available for historical records.

  DEUTSCH
  Tabelle: patients. Speichert Patientenstammdaten, optionale Wohn- und
  Rechnungsadressen, Heimkontext und Lebenszyklusinformationen. Ein Patient
  kann auch aus anderen Gründen als einem Todesfall inaktiv sein und bleibt für
  historische Belege erhalten.
  '''
}

Table services {
  id integer [pk, increment, note: '''ENGLISH: Internal unique service/product identifier. DEUTSCH: Interne eindeutige Kennung der Leistung bzw. des Produkts.''']
  name varchar(200) [not null, note: '''ENGLISH: Official service or product name; source of truth for new invoice items. DEUTSCH: Offizielle Leistungs- oder Produktbezeichnung; maßgeblich für neue Rechnungspositionen.''']
  description text [note: '''ENGLISH: Optional detailed service/product description. DEUTSCH: Optionale ausführliche Beschreibung der Leistung bzw. des Produkts.''']
  net_price numeric(12, 2) [not null, note: '''ENGLISH: Current exact net price from master data. DEUTSCH: Aktueller exakter Nettopreis aus den Stammdaten.''']
  vat_rate numeric(5, 2) [not null, note: '''ENGLISH: Current VAT percentage from master data. DEUTSCH: Aktueller Umsatzsteuersatz in Prozent aus den Stammdaten.''']
  active boolean [not null, note: '''ENGLISH: Selectability flag; application default is true. Inactive services are not used for new matching. DEUTSCH: Kennzeichnet die Auswählbarkeit; Anwendungsstandard ist true. Inaktive Leistungen werden nicht für neue Zuordnungen genutzt.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']

  Note: '''
  ENGLISH
  Table: services. Stores the current catalogue of podology services and sale
  products. Price and tax values are copied into invoice-item snapshots so that
  later catalogue changes cannot alter historical billing data.

  DEUTSCH
  Tabelle: services. Speichert den aktuellen Katalog podologischer Leistungen
  und Verkaufsprodukte. Preis- und Steuerwerte werden in Rechnungspositionen
  als Snapshots kopiert, damit spätere Katalogänderungen historische
  Abrechnungsdaten nicht verändern.
  '''
}

Table business_profiles {
  id integer [pk, increment, note: '''ENGLISH: Internal unique business-profile identifier. DEUTSCH: Interne eindeutige Kennung des Firmenprofils.''']
  business_name varchar(200) [not null, note: '''ENGLISH: Legal or business name of the invoice issuer. DEUTSCH: Firmen- bzw. Geschäftsname des Rechnungsausstellers.''']
  location_name varchar(200) [not null, note: '''ENGLISH: Human-readable practice or location name. DEUTSCH: Sichtbarer Praxis- oder Standortname.''']
  location_code varchar(30) [note: '''ENGLISH: Optional location abbreviation; it is intentionally not unique. DEUTSCH: Optionales Standortkürzel; es ist bewusst nicht eindeutig.''']
  invoice_prefix varchar(50) [not null, unique, note: '''ENGLISH: Stable server-assigned invoice prefix; it must never be recalculated after assignment. DEUTSCH: Stabiles serverseitig vergebenes Rechnungspräfix; es darf nach der Vergabe nie neu berechnet werden.''']
  street varchar(200) [not null, note: '''ENGLISH: Street and house number of the billing profile. DEUTSCH: Straße und Hausnummer des Abrechnungsprofils.''']
  postal_code varchar(20) [not null, note: '''ENGLISH: Postal code of the billing profile. DEUTSCH: Postleitzahl des Abrechnungsprofils.''']
  city varchar(120) [not null, note: '''ENGLISH: City of the billing profile. DEUTSCH: Ort des Abrechnungsprofils.''']
  phone varchar(50) [note: '''ENGLISH: Optional telephone number for document output. DEUTSCH: Optionale Telefonnummer für die Belegausgabe.''']
  email varchar(254) [note: '''ENGLISH: Optional e-mail address for document output. DEUTSCH: Optionale E-Mail-Adresse für die Belegausgabe.''']
  tax_number varchar(50) [note: '''ENGLISH: Optional tax number. DEUTSCH: Optionale Steuernummer.''']
  vat_id varchar(50) [note: '''ENGLISH: Optional VAT identification number. DEUTSCH: Optionale Umsatzsteuer-Identifikationsnummer.''']
  ik_number varchar(50) [note: '''ENGLISH: Optional German institution code (IK). DEUTSCH: Optionales deutsches Institutionskennzeichen (IK).''']
  iban varchar(34) [not null, note: '''ENGLISH: IBAN used for invoice payment information and GiroCode creation. DEUTSCH: IBAN für Zahlungsinformationen und die GiroCode-Erzeugung.''']
  bic varchar(11) [note: '''ENGLISH: Optional BIC used where payment information requires it. DEUTSCH: Optionaler BIC, soweit für Zahlungsinformationen erforderlich.''']
  bank_name varchar(200) [note: '''ENGLISH: Optional bank name for payment information. DEUTSCH: Optionaler Bankname für Zahlungsinformationen.''']
  logo_path varchar(500) [note: '''ENGLISH: Optional local logo reference for generated PDFs. DEUTSCH: Optionaler lokaler Logo-Verweis für erzeugte PDFs.''']
  active boolean [not null, note: '''ENGLISH: Selectability flag; application default is true. DEUTSCH: Kennzeichnet die Auswählbarkeit; Anwendungsstandard ist true.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']
  updated_at datetime [not null, note: '''ENGLISH: UTC timestamp updated by the application on changes. DEUTSCH: Von der Anwendung bei Änderungen aktualisierter UTC-Zeitpunkt.''']

  Note: '''
  ENGLISH
  Table: business_profiles. Stores invoice issuers, practice locations, tax and
  bank data, logo references and the permanent invoice prefix. Multiple profiles
  may share the same location_code while every invoice_prefix remains unique.

  DEUTSCH
  Tabelle: business_profiles. Speichert Rechnungsaussteller, Praxisstandorte,
  Steuer- und Bankdaten, Logo-Verweise und das dauerhafte Rechnungspräfix.
  Mehrere Profile dürfen dasselbe location_code verwenden, jedes invoice_prefix
  bleibt jedoch eindeutig.
  '''
}

Table invoice_prefix_reservations {
  id integer [pk, increment, note: '''ENGLISH: Internal unique reservation identifier. DEUTSCH: Interne eindeutige Kennung der Präfixreservierung.''']
  invoice_prefix varchar(50) [not null, unique, note: '''ENGLISH: Permanently reserved prefix, never reused after profile deletion. DEUTSCH: Dauerhaft reserviertes Präfix, das auch nach Profil-Löschung nie wiederverwendet wird.''']
  created_at datetime [not null, note: '''ENGLISH: UTC timestamp of permanent reservation. DEUTSCH: UTC-Zeitpunkt der dauerhaften Reservierung.''']

  Note: '''
  ENGLISH
  Table: invoice_prefix_reservations. Preserves every assigned invoice prefix.
  It deliberately has no foreign key to business_profiles so a hard-deleted
  profile cannot release a historically used prefix.

  DEUTSCH
  Tabelle: invoice_prefix_reservations. Bewahrt jedes vergebene Rechnungspräfix.
  Sie besitzt bewusst keinen Fremdschlüssel zu business_profiles, damit ein
  endgültig gelöschtes Profil kein historisch verwendetes Präfix freigibt.
  '''
}

Table invoices {
  id integer [pk, increment, note: '''ENGLISH: Internal unique invoice/document identifier. DEUTSCH: Interne eindeutige Kennung der Rechnung bzw. des Belegs.''']
  invoice_number varchar(50) [unique, note: '''ENGLISH: Globally unique final document number; nullable until finalization. DEUTSCH: Global eindeutige endgültige Belegnummer; bis zur Finalisierung nullable.''']
  patient_id integer [note: '''ENGLISH: Optional header patient reference. It is nullable for drafts, collective invoices and unresolved AI drafts. DEUTSCH: Optionale Patientenreferenz im Belegkopf. Sie ist für Entwürfe, Sammelrechnungen und ungeklärte KI-Entwürfe nullable.''']
  business_profile_id integer [note: '''ENGLISH: Optional issuing business-profile reference; finalization requires a valid active profile. DEUTSCH: Optionale Referenz auf das ausstellende Firmenprofil; die Finalisierung verlangt ein gültiges aktives Profil.''']
  document_type varchar(30) [not null, note: '''ENGLISH: Document type; current application values are INVOICE, COLLECTIVE_INVOICE and RECEIPT. DEUTSCH: Belegart; aktuelle Anwendungswerte sind INVOICE, COLLECTIVE_INVOICE und RECEIPT.''']
  invoice_date date [not null, note: '''ENGLISH: Official invoice/document date. DEUTSCH: Offizielles Rechnungs- bzw. Belegdatum.''']
  due_date date [not null, note: '''ENGLISH: Payment due date, also used as the start point for reminder stage 0. DEUTSCH: Zahlungsfälligkeitsdatum, zugleich Ausgangspunkt für Erinnerungsstufe 0.''']
  status varchar(30) [not null, note: '''ENGLISH: Invoice lifecycle status; DRAFT is editable and FINAL is write-protected by the API. DEUTSCH: Lebenszyklusstatus der Rechnung; DRAFT ist bearbeitbar, FINAL wird durch die API geschützt.''']
  total_net numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated invoice net total. DEUTSCH: Deterministisch berechneter Nettogesamtbetrag der Rechnung.''']
  total_vat numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated invoice VAT total. DEUTSCH: Deterministisch berechneter Umsatzsteuer-Gesamtbetrag der Rechnung.''']
  total_gross numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated gross amount; base for payment and reminder balances. DEUTSCH: Deterministisch berechneter Bruttobetrag; Grundlage für Zahlungen und Mahnrestbeträge.''']
  source_text text [note: '''ENGLISH: Original AI input text retained exactly for an AI-created draft. DEUTSCH: Unverändert gespeicherter Originaltext einer KI-erzeugten Entwurfsrechnung.''']
  ai_review_comment text [note: '''ENGLISH: Optional manual-review message after AI validation. DEUTSCH: Optionaler Hinweis zur manuellen Prüfung nach der KI-Validierung.''']
  new_patient_data json [note: '''ENGLISH: Temporary AI-extracted patient data; it is not yet a patient master record. DEUTSCH: Temporäre, KI-extrahierte Patientendaten; sie sind noch kein Patientenstammdatensatz.''']
  patient_resolution_required boolean [not null, note: '''ENGLISH: Signals that a patient choice or correction is still required; application default is false. DEUTSCH: Kennzeichnet, dass noch eine Patientenauswahl oder -korrektur nötig ist; Anwendungsstandard ist false.''']
  unresolved_items json [not null, note: '''ENGLISH: List of unresolved AI service candidates; application default is an empty list. DEUTSCH: Liste ungeklärter KI-Leistungskandidaten; Anwendungsstandard ist eine leere Liste.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']

  Note: '''
  ENGLISH
  Table: invoices. Stores the document header, calculated totals and optional
  AI-draft metadata. FINAL documents receive their invoice_number only at
  finalization; DRAFT documents retain editable, unresolved state where needed.

  DEUTSCH
  Tabelle: invoices. Speichert den Belegkopf, berechnete Summen und optionale
  KI-Entwurfsmetadaten. FINAL-Belege erhalten invoice_number erst bei der
  Finalisierung; DRAFT-Belege können erforderlichenfalls einen bearbeitbaren,
  noch ungeklärten Zustand behalten.
  '''
}

Table invoice_items {
  id integer [pk, increment, note: '''ENGLISH: Internal unique invoice-item identifier. DEUTSCH: Interne eindeutige Kennung der Rechnungsposition.''']
  invoice_id integer [not null, note: '''ENGLISH: Required reference to the containing invoice. DEUTSCH: Erforderliche Referenz auf die enthaltende Rechnung.''']
  patient_id integer [note: '''ENGLISH: Optional patient reference for this individual item, especially relevant for collective invoices. DEUTSCH: Optionale Patientenreferenz dieser einzelnen Position, besonders relevant für Sammelrechnungen.''']
  service_id integer [note: '''ENGLISH: Optional current service/product reference; historical billing data is stored separately as snapshots. DEUTSCH: Optionale Referenz auf die aktuelle Leistung bzw. das Produkt; historische Abrechnungsdaten werden separat als Snapshots gespeichert.''']
  patient_name_snapshot varchar(250) [note: '''ENGLISH: Optional frozen patient name used on the document. DEUTSCH: Optional eingefrorener Patientenname für den Beleg.''']
  service_name_snapshot varchar(250) [note: '''ENGLISH: Optional frozen official service/product name used on the document. DEUTSCH: Optional eingefrorene offizielle Leistungs-/Produktbezeichnung für den Beleg.''']
  description text [not null, note: '''ENGLISH: Mandatory display description snapshot of the line item. DEUTSCH: Verpflichtender Anzeige-Beschreibungs-Snapshot der Position.''']
  quantity numeric(12, 2) [not null, note: '''ENGLISH: Exact billed quantity. DEUTSCH: Exakt abgerechnete Menge.''']
  unit_net_price numeric(12, 2) [not null, note: '''ENGLISH: Frozen net unit-price snapshot. DEUTSCH: Eingefrorener Netto-Einzelpreis-Snapshot.''']
  vat_rate numeric(5, 2) [not null, note: '''ENGLISH: Frozen VAT-rate snapshot in percent. DEUTSCH: Eingefrorener Umsatzsteuer-Snapshot in Prozent.''']
  line_net numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated net amount for this line. DEUTSCH: Deterministisch berechneter Nettobetrag dieser Position.''']
  line_vat numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated VAT amount for this line. DEUTSCH: Deterministisch berechneter Umsatzsteuerbetrag dieser Position.''']
  line_gross numeric(12, 2) [not null, note: '''ENGLISH: Deterministically calculated gross amount for this line. DEUTSCH: Deterministisch berechneter Bruttobetrag dieser Position.''']

  Note: '''
  ENGLISH
  Table: invoice_items. Stores billed lines and their patient/service references.
  The name, description, price and VAT fields are document snapshots and must
  remain independent of later changes in patients or services.

  DEUTSCH
  Tabelle: invoice_items. Speichert abgerechnete Positionen und ihre Patienten-/
  Leistungsreferenzen. Die Namens-, Beschreibungs-, Preis- und Steuerfelder sind
  Beleg-Snapshots und müssen von späteren Änderungen an Patienten oder Leistungen
  unabhängig bleiben.
  '''
}

Table payments {
  id integer [pk, increment, note: '''ENGLISH: Internal unique payment identifier. DEUTSCH: Interne eindeutige Kennung der Zahlung.''']
  invoice_id integer [not null, note: '''ENGLISH: Required reference to the paid invoice. DEUTSCH: Erforderliche Referenz auf die bezahlte Rechnung.''']
  amount numeric(12, 2) [not null, note: '''ENGLISH: Positive exact payment amount; several rows represent partial payments. DEUTSCH: Positiver exakter Zahlungsbetrag; mehrere Zeilen bilden Teilzahlungen ab.''']
  payment_date date [not null, note: '''ENGLISH: Date on which this payment was received. DEUTSCH: Datum, an dem diese Zahlung eingegangen ist.''']
  payment_method varchar(30) [note: '''ENGLISH: Optional payment method, currently CASH or BANK_TRANSFER in the API. DEUTSCH: Optionale Zahlungsart, derzeit CASH oder BANK_TRANSFER in der API.''']
  note text [note: '''ENGLISH: Optional free-text payment note. DEUTSCH: Optionale Freitextnotiz zur Zahlung.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']

  Note: '''
  ENGLISH
  Table: payments. Stores payments separately from the immutable invoice amount.
  The application derives paid_amount, remaining_amount and payment status from
  these rows and prevents the sum from exceeding total_gross.

  DEUTSCH
  Tabelle: payments. Speichert Zahlungen getrennt vom unveränderlichen
  Rechnungsbetrag. Die Anwendung leitet paid_amount, remaining_amount und den
  Zahlungsstatus aus diesen Zeilen ab und verhindert eine Überzahlung.
  '''
}

Table reminder_settings {
  id integer [pk, increment, note: '''ENGLISH: Internal unique reminder-setting identifier. DEUTSCH: Interne eindeutige Kennung der Mahnstufenkonfiguration.''']
  sequence integer [not null, unique, note: '''ENGLISH: Globally unique stage number 0-10; 0 is PAYMENT_REMINDER, 1-10 are REMINDER. DEUTSCH: Global eindeutige Stufennummer 0-10; 0 ist PAYMENT_REMINDER, 1-10 sind REMINDER.''']
  type varchar(30) [not null, note: '''ENGLISH: Reminder document type, constrained by application validation together with sequence. DEUTSCH: Typ des Erinnerungsbelegs, durch Anwendungsvalidierung gemeinsam mit sequence eingeschränkt.''']
  deadline_days integer [not null, note: '''ENGLISH: Number of days after the preceding due event before this stage is due. DEUTSCH: Anzahl Tage nach dem vorherigen Fälligkeitsereignis, bis diese Stufe fällig wird.''']
  reminder_fee numeric(12, 2) [not null, note: '''ENGLISH: Fee copied as a snapshot into new reminders; application default is 0.00. DEUTSCH: Gebühr, die als Snapshot in neue Reminders kopiert wird; Anwendungsstandard ist 0.00.''']
  postage_fee numeric(12, 2) [not null, note: '''ENGLISH: Postage copied as a snapshot into new reminders; application default is 0.00. DEUTSCH: Porto, das als Snapshot in neue Reminders kopiert wird; Anwendungsstandard ist 0.00.''']
  active boolean [not null, note: '''ENGLISH: Enables this stage for new due processing; application default is true. DEUTSCH: Aktiviert diese Stufe für neue Fälligkeitsprüfungen; Anwendungsstandard ist true.''']
  auto_create_draft boolean [not null, note: '''ENGLISH: Allows /reminders/due to prepare a DRAFT automatically, never ISSUED; application default is false. DEUTSCH: Erlaubt /reminders/due, automatisch einen DRAFT vorzubereiten, niemals ISSUED; Anwendungsstandard ist false.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']
  updated_at datetime [not null, note: '''ENGLISH: UTC timestamp updated by the application on changes. DEUTSCH: Von der Anwendung bei Änderungen aktualisierter UTC-Zeitpunkt.''']

  Note: '''
  ENGLISH
  Table: reminder_settings. Globally configures payment reminder stage 0 and
  reminder stages 1 through 10. Settings are used for future due processing;
  fees are copied into reminders to preserve historical values.

  DEUTSCH
  Tabelle: reminder_settings. Konfiguriert global die Zahlungserinnerungsstufe
  0 und Mahnstufen 1 bis 10. Einstellungen steuern künftige Fälligkeitsprüfungen;
  Gebühren werden in Reminders kopiert, damit historische Werte erhalten bleiben.
  '''
}

Table reminders {
  id integer [pk, increment, note: '''ENGLISH: Internal unique reminder identifier. DEUTSCH: Interne eindeutige Kennung des Erinnerungs-/Mahnvorgangs.''']
  invoice_id integer [not null, note: '''ENGLISH: Required reference to the FINAL invoice whose balance is reminded. DEUTSCH: Erforderliche Referenz auf die FINAL-Rechnung, deren Restforderung erinnert wird.''']
  sequence integer [not null, note: '''ENGLISH: Copied reminder stage number; 0 is PAYMENT_REMINDER and 1-10 are REMINDER. DEUTSCH: Kopierte Mahnstufennummer; 0 ist PAYMENT_REMINDER und 1-10 sind REMINDER.''']
  type varchar(30) [not null, note: '''ENGLISH: Copied reminder type from the setting. DEUTSCH: Aus der Einstellung übernommener Reminder-Typ.''']
  open_amount numeric(12, 2) [not null, note: '''ENGLISH: Snapshot of the outstanding principal invoice amount at reminder creation. DEUTSCH: Snapshot der offenen Hauptforderung der Rechnung bei Erstellung des Reminders.''']
  reminder_fee numeric(12, 2) [not null, note: '''ENGLISH: Snapshot of the configured reminder fee at creation. DEUTSCH: Snapshot der konfigurierten Mahngebühr bei Erstellung.''']
  postage_fee numeric(12, 2) [not null, note: '''ENGLISH: Snapshot of the configured postage fee at creation. DEUTSCH: Snapshot des konfigurierten Portos bei Erstellung.''']
  status varchar(30) [not null, note: '''ENGLISH: Lifecycle status DRAFT, ISSUED, PAID or CANCELLED; application default is DRAFT. DEUTSCH: Lebenszyklusstatus DRAFT, ISSUED, PAID oder CANCELLED; Anwendungsstandard ist DRAFT.''']
  issued_at datetime [note: '''ENGLISH: Optional UTC timestamp set only when a DRAFT is explicitly issued. DEUTSCH: Optionaler UTC-Zeitpunkt, der nur beim ausdrücklichen Ausstellen eines DRAFT gesetzt wird.''']
  snoozed_until date [note: '''ENGLISH: Optional date until which an active DRAFT is excluded from due work. DEUTSCH: Optionales Datum, bis zu dem ein aktiver DRAFT von fälligen Aufgaben ausgeschlossen ist.''']
  reminder_fee_waived boolean [not null, note: '''ENGLISH: Fee-waiver flag; application default is false and does not alter the fee snapshot. DEUTSCH: Erlass-Flag für die Mahngebühr; Anwendungsstandard ist false und der Gebühren-Snapshot bleibt unverändert.''']
  postage_fee_waived boolean [not null, note: '''ENGLISH: Postage-waiver flag; application default is false and does not alter the postage snapshot. DEUTSCH: Erlass-Flag für Porto; Anwendungsstandard ist false und der Porto-Snapshot bleibt unverändert.''']
  created_at datetime [not null, note: '''ENGLISH: UTC creation timestamp managed by the application. DEUTSCH: Von der Anwendung gesetzter UTC-Zeitpunkt der Anlage.''']
  updated_at datetime [not null, note: '''ENGLISH: UTC timestamp updated by the application on changes. DEUTSCH: Von der Anwendung bei Änderungen aktualisierter UTC-Zeitpunkt.''']

  Indexes {
    (invoice_id, sequence) [unique, name: 'uq_reminders_active_invoice_sequence', note: '''ENGLISH: Partial unique index: only statuses DRAFT and ISSUED are mutually unique per invoice and sequence. PAID or CANCELLED history does not block a new active reminder. DEUTSCH: Partieller Unique-Index: Nur die Status DRAFT und ISSUED sind je Rechnung und Sequenz gegenseitig eindeutig. PAID- oder CANCELLED-Historie blockiert keinen neuen aktiven Reminder.''']
  }

  Note: '''
  ENGLISH
  Table: reminders. Stores prepared payment reminders and reminders without any
  automatic delivery. DRAFT remains an open task, ISSUED starts the next-stage
  timeline, PAID closes active reminders after full payment, and CANCELLED
  preserves cancelled history. Snapshot fields preserve the principal and fees
  at creation; waiver flags only affect whether the respective fee is charged.

  DEUTSCH
  Tabelle: reminders. Speichert vorbereitete Zahlungserinnerungen und Mahnungen
  ohne automatischen Versand. DRAFT bleibt eine offene Aufgabe, ISSUED startet
  die Frist der nächsten Stufe, PAID schließt aktive Reminders nach vollständiger
  Zahlung und CANCELLED bewahrt abgebrochene Historie. Snapshot-Felder erhalten
  Hauptforderung und Gebühren bei Erstellung; Erlass-Flags steuern nur, ob die
  jeweilige Gebühr berechnet wird.
  '''
}

Ref: invoices.patient_id > patients.id
Ref: invoices.business_profile_id > business_profiles.id
Ref: invoice_items.invoice_id > invoices.id
Ref: invoice_items.patient_id > patients.id
Ref: invoice_items.service_id > services.id
Ref: payments.invoice_id > invoices.id
Ref: reminders.invoice_id > invoices.id
